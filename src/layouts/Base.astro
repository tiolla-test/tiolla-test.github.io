---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/onest';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import profile from '../data/profile.json';
import photoSrc from '../assets/photo.jpg';
import { UI, homeUrl, assetUrl } from '../lib/i18n.js';
import { ogImage } from '../lib/cases.js';

const { lang, page, title, description, altHref, image } = Astro.props;
const t = (ru, en) => (lang === 'ru' ? ru : en);
const name = profile.name[lang];
const fullTitle = title ? `${title} · ${name} · ${UI[lang].title}` : `${name} · ${UI[lang].title}`;
const desc = description || UI[lang].description;
/* links in previews and for search engines need full addresses; without SITE_URL they stay relative */
const abs = (p) => (Astro.site ? new URL(p, Astro.site).href : p);
const shareImg = image || await ogImage(photoSrc);
const indexed = page !== 'error';
const links = [
  ['work', 'Работы', 'Work'],
  ['about', 'Обо мне', 'About'],
  ['experience', 'Опыт', 'Experience'],
  ['education', 'Образование', 'Education'],
  ['contact', 'Контакты', 'Contact'],
];
const otherLang = lang === 'ru' ? 'en' : 'ru';
const langHref = { [lang]: Astro.url.pathname, [otherLang]: altHref };
const paletteHtml = '<div class="pal-list">' + profile.palettes.map((p) =>
  `<button type="button" data-theme-set="${p.id}" aria-pressed="${p.id === profile.palette}" style="--a:${p.accent};--b:${p.dark}"><i></i>${p[lang]}</button>`).join('') + '</div>';
---
<!doctype html>
<html lang={lang} data-lang={lang} data-page={page} data-theme={profile.palette}
  class:list={[page === 'home' ? 'in-home' : 'in-case', { 'no-pal': !profile.paletteSwitch }]}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{fullTitle}</title>
<meta name="description" content={desc}>
<meta name="theme-color" content="#0F0F0E">
<link rel="icon" href={assetUrl('favicon.ico')} sizes="32x32">
<link rel="icon" href={assetUrl('favicon.svg')} type="image/svg+xml">
<link rel="apple-touch-icon" href={assetUrl('apple-touch-icon.png')}>
{indexed ? (
  <>
    <link rel="canonical" href={abs(langHref[lang])}>
    <link rel="alternate" hreflang="ru" href={abs(langHref.ru)}>
    <link rel="alternate" hreflang="en" href={abs(langHref.en)}>
    <link rel="alternate" hreflang="x-default" href={abs(langHref.ru)}>
  </>
) : <meta name="robots" content="noindex">}
<meta property="og:type" content={page === 'case' ? 'article' : 'website'}>
<meta property="og:site_name" content={`${name} · ${UI[lang].title}`}>
<meta property="og:title" content={title || fullTitle}>
<meta property="og:description" content={desc}>
{indexed && <meta property="og:url" content={abs(langHref[lang])}>}
<meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'}>
<meta property="og:image" content={abs(shareImg.src)}>
<meta property="og:image:width" content={String(shareImg.width)}>
<meta property="og:image:height" content={String(shareImg.height)}>
<meta name="twitter:card" content="summary_large_image">
<script is:inline>
(function () {
  var R = document.documentElement, m = null, seen = null, th = null, wipe = null;
  try { m = localStorage.getItem('pf-motion'); seen = sessionStorage.getItem('pf-seen'); th = localStorage.getItem('pf-theme'); wipe = sessionStorage.getItem('pf-wipe'); sessionStorage.removeItem('pf-wipe'); } catch (e) {}
  if (th && /^[a-z]+$/.test(th)) R.setAttribute('data-theme', th);
  var qm = location.search.match(/[?&]motion=(full|calm)/);
  if (qm) m = qm[1];
  if (m !== 'full' && m !== 'calm') m = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'calm' : 'full';
  R.classList.add(m === 'full' ? 'm-full' : 'm-calm');
  if (m === 'full' && wipe) R.classList.add('wipe-in');
  else if (m === 'full' && !seen && R.getAttribute('data-page') === 'home' && document.visibilityState === 'visible' && matchMedia('(hover: hover) and (pointer: fine)').matches) R.classList.add('show-pre');
  setTimeout(function () { R.classList.add('failsafe'); }, 5000);
})();
</script>
</head>
<body>
<a class="skip" href={page === 'home' ? '#work' : '#main'}>{t('К работам', 'Skip to work')}</a>

{page === 'home' && (
  <div class="pre" aria-hidden="true">
    <div class="pre-top mono"><span>{t('Портфолио', 'Portfolio')}</span><span>{t('Продуктовый дизайнер', 'Product designer')}</span></div>
    <div><div class="pre-num">000</div><div class="pre-bar"><i></i></div></div>
  </div>
)}

<div class="cur" aria-hidden="true"><div class="cur-ring"><span></span></div><div class="cur-dot"></div></div>
<div class="wipe" aria-hidden="true"></div>
<div class="prog" aria-hidden="true"><i></i></div>
<div class="grain" aria-hidden="true"></div>

<header class="nav">
  <a class="logo" href={homeUrl(lang)} aria-label={t('Портфолио', 'Portfolio')}><i></i>{name}</a>
  <nav class="nav-links" aria-label={t('Разделы сайта', 'Site sections')}>
    {links.map(([id, ru, en]) => <a href={homeUrl(lang, '#' + id)}>{t(ru, en)}</a>)}
  </nav>
  <div class="tgl" role="group" aria-label="Язык / Language">
    {['ru', 'en'].map((l) => <a href={langHref[l]} hreflang={l} lang={l} data-lang-set={l} aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>)}
  </div>
  <button type="button" class="mtg" aria-pressed="true">
    <span class="mtg-l">{t('Анимация', 'Motion')}</span><span class="sw" aria-hidden="true"><i></i></span>
  </button>
  <button type="button" class="pal-btn" aria-expanded="false" aria-controls="pal"><i></i>{t('Цвет', 'Color')}</button>
  <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu">{t('Меню', 'Menu')}</button>
</header>

<div class="pal" id="pal" hidden><p class="mono">{t('Цвет сайта', 'Site colors')}</p><Fragment set:html={paletteHtml} /></div>

<div class="menu" id="menu">
  {links.map(([id, ru, en]) => <a href={homeUrl(lang, '#' + id)}>{t(ru, en)}</a>)}
  <div class="menu-set">
    <div class="tgl" role="group" aria-label="Язык / Language">
      {['ru', 'en'].map((l) => <a href={langHref[l]} hreflang={l} lang={l} data-lang-set={l} aria-current={l === lang ? 'page' : undefined}>{l.toUpperCase()}</a>)}
    </div>
    <button type="button" class="mtg" aria-pressed="true">
      <span class="mtg-l">{t('Анимация', 'Motion')}</span><span class="sw" aria-hidden="true"><i></i></span>
    </button>
  </div>
  <Fragment set:html={paletteHtml} />
</div>

<slot />

<div class="lb" hidden data-lenis-prevent role="dialog" aria-modal="true" aria-label={t('Кадр', 'Image')}><button type="button" class="lb-x mono">{t('Закрыть', 'Close')} ✕</button><img alt=""></div>

<script src="../scripts/app.js"></script>
</body>
</html>

